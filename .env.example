# Copy to .env and fill in. All optional. Empty = feature off.

# Your NQ address for NIM tips.
VITE_TIP_NIM_ADDRESS=

# Your 0x Polygon address for USDT tips.
VITE_TIP_USDT_ADDRESS=

# Website ID from cloud.umami.is for open counting.
VITE_UMAMI_WEBSITE_ID=

# Prod domains, comma-separated. Keeps localhost out of stats.
VITE_UMAMI_DOMAINS=
